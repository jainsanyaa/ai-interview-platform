{
  "version": 2,
  "buildCommand": "cd ai-interview-platform/frontend && npm install && npm run build",
  "outputDirectory": "ai-interview-platform/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
